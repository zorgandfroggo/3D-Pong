{
    "gameObjects": [],
    "lights": [],
    "scripts": [
        {
            "buffer": "local menuUI\nlocal lives\nlocal scoreUI\nlocal scoreText\nlocal endUI\nlocal retryButton\nlocal cube\nlocal tag\nlocal paddle\nlocal paddleTag\n\nlocal function mainMenu()\n    menuUI = createWidget();\n    menuUI.show = true\n    menuUI.title = \"Menu\"\n    menuUI.size.x = 1920\n    menuUI.size.y = 1080\n    local playButton = menuUI:createContext(uiContext.button, \"Play\");\n\n    playButton.onClick = function()\n        print(\"Clicked!\")\n        menuUI.show = false\n    end\nend\n\n-- Functions\n\nlocal function reset()\n    tag.velocity.x = 10\n    tag.velocity.y = 10\n    paddle.position.y = 0\n    endUI.show = false\n    scoreUI.show = true\n    lives = 3\n    scoreText.text = lives\nend\n\nlocal function initializeAssets()\n    -- Create UI\n\n    lives = 3\n    scoreUI = createWidget()\n    scoreUI.show = true\n    scoreUI.title = \"Lives left\"\n    scoreUI.position.y = 500\n    scoreText = scoreUI:createContext(uiContext.text, lives)\n\n    endUI = createWidget()\n    endUI.show = false\n    endUI.title = \"Game over\"\n    endUI.position.x = 100\n    endUI.position.y = 100\n    retryButton = endUI:createContext(uiContext.button, \"Retry\")\n\n    retryButton.onClick = function()\n        reset()\n    end\n\n    -- Create cube\n\n    cube = createCube()\n    tag = cube:createTag(tagType.physics)\n    tag.gravity = false\n    tag.velocity.x = 10\n    tag.velocity.y = 10\n\n    -- Create paddle\n\n    paddle = createCube()\n    paddle.scale.x = 3\n    paddle.scale.y = .5\n    paddle.position.x = 10\n    paddle.rotation.z = 90\n    paddleTag = paddle:createTag(tagType.physics)\n    paddleTag.gravity = false\n    paddleTag.static = true\n\n    -- Create light\n\n    local light = createPointLight()\n    light.position.z = 5\n    light.intensity = 5\n\n    -- Create camera\n\n    local cam = createCamera()\n    cam.position.z = 30\n    cam.freeLook = false\n    cam.direction.z = -1\n    cam.direction.y = 0\n    cam.direction.x = 0\n    cam:calculateDirection()\n    setActiveCamera(cam)\n\n    -- Create border\n\n    local edge1 = createCube()\n    edge1.baseColor.r = 0\n    edge1.baseColor.b = 0\n    edge1.baseColor.g = 0\n    edge1.scale.x = 20\n    edge1.position.y = 25\n    local edgeTag1 = edge1:createTag(tagType.physics)\n    edgeTag1.gravity = false\n    edgeTag1.static = true\n\n    local edge2 = createCube()\n    edge2.baseColor.r = 0\n    edge2.baseColor.b = 0\n    edge2.baseColor.g = 0\n    edge2.scale.x = 20\n    edge2.position.y = -25\n    local edgeTag2 = edge2:createTag(tagType.physics)\n    edgeTag2.gravity = false\n    edgeTag2.static = true\n\n    local edge3 = createCube()\n    edge3.baseColor.r = 0\n    edge3.baseColor.b = 0\n    edge3.baseColor.g = 0\n    edge3.scale.y = 25\n    edge3.position.x = -13\n    local edgeTag3 = edge3:createTag(tagType.physics)\n    edgeTag3.gravity = false\n    edgeTag3.static = true\nend\n\nlocal function lifeLost()\n    lives = lives - 1\n    scoreText.text = lives\n    cube.position.x = 0\n    cube.position.y = 0\nend\n\n-- Game loop\n\nfunction gameLoop()\n    local initialized = false\n    while true do\n        if initialized and not menuUI.show and lives > 0 then\n            local keys = captureKeyboard()\n            if (keys[65]) and paddle.position.y >= -19 then\n                paddle.position.y = paddle.position.y - .5\n            end\n            if (keys[68]) and paddle.position.y <= 19 then\n                paddle.position.y = paddle.position.y + .5\n            end\n\n            if (cube.position.x >= 20) and lives > 0 then\n                lifeLost()\n            elseif (lives <= 0) then\n                break\n            end\n        elseif not menuUI.show and not initialized then\n            initialized = true\n            initializeAssets()\n        elseif initialized and lives <= 0 then\n            endUI.show = true\n            scoreUI.show = false\n            tag.velocity.x = 0\n            tag.velocity.y = 0\n        end\n\n        wait(.01)\n    end\nend\n\n-- Start\n\nfunction main()\n    mainMenu();\n    gameLoop()\nend\n\nmain()",
            "name": "pong.lua"
        }
    ],
    "windowName": "Pong"
}